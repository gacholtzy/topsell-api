# Salin ke .env (lokal) atau isi di Vercel: Settings -> Environment Variables. File .env tidak masuk repo.

# Postgres (mis. Neon). Tabel dibuat otomatis saat start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# --- MODE (penting) ---
# Laptop sendiri: DEV_MODE=true -> OTP 1234, endpoint /dev/*, dan /docs terbuka.
# Vercel / server yang bisa diakses orang lain: JANGAN set DEV_MODE (default mati) dan isi:
#   OTP_CODE       4 digit yang tidak mudah ditebak (server menolak start kalau kosong/1234/0000)
#   DOCS_PASSWORD  password /docs (kosong = /docs mati). DOCS_USER opsional (default: topsell)
DEV_MODE=true
# OTP_CODE=
# DOCS_USER=topsell
# DOCS_PASSWORD=
# TRUST_PROXY=true   # otomatis aktif di Vercel; set manual bila di belakang Nginx/Caddy/Cloudflare

# Biteship (key testing "biteship_test..." cukup). Kosong = alamat & ongkir pakai data contoh.
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=61219
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
SHIPPER_NAME=Topsell Belanja
SHIPPER_PHONE=081234567890
SHIPPER_EMAIL=toko@topsell.test
ORIGIN_ADDRESS=Jl. Ahmad Yani No. 1, Sidoarjo

# Opsional
# FRONTEND_URL=http://localhost:3000
# DEFAULT_ITEM_WEIGHT_GRAMS=1000
# TRACKING_URL_TEMPLATE=https://cekresi.com/?noresi={resi}
